    "public_pages_json": {
      "about": {
        "slug": "about",
        "title_ar": "من نحن",
        "subtitle_ar": "تيتر ليبيا — بوابة التداول المباشر للتيتر في ليبيا",
        "body_ar": "تيتر ليبيا (Tether Libya) منصة مالية متخصصة في تسهيل عمليات شراء وبيع USDT بالدينار الليبي بشكل مباشر وآمن، دون الحاجة لمحفظة داخلية، مع مراجعة يدوية دقيقة لكل معاملة وشفافية كاملة في التسعير المحدث لحظياً ووسائل الدفع المحلية المعتمدة.",
        "is_visible": true
      },
      "how-it-works": {
        "slug": "how-it-works",
        "title_ar": "آلية الشراء والبيع",
        "subtitle_ar": "خطوات واضحة لتنفيذ طلبك مباشرة وبأمان",
        "body_ar": "عند شراء USDT: أدخل المبلغ المطلوب، اختر وسيلة الدفع (LYPay أو OnePay)، حوّل القيمة للحساب المعروض وارفع إيصال الدفع مع عنوان محفظة TRON الخاصة بك. عند بيع USDT: أرسل الكمية إلى عنوان TRON الخاص بالمنصة، أدخل Hash المعاملة وبيانات حسابك المصرفي الليبي ليقوم المشرفون بمراجعة التحويل وتنفيذ الصرف يدوياً.",
        "is_visible": true
      },
      "faq": {
        "slug": "faq",
        "title_ar": "الأسئلة الشائعة",
        "subtitle_ar": "إجابات وافية حول الشراء والبيع والتحقق وتوثيق الحساب",
        "body_ar": "تتم جميع العمليات مباشرة بين محفظتك وحسابك المصرفي دون الاحتفاظ بأرصدة داخلية. وقت المراجعة المعتاد يتراوح بين 5 إلى 30 دقيقة خلال ساعات العمل. جميع المعاملات تخضع للتحقق اليدوي من فريق الامتثال والإشراف المالي لضمان حماية الطرفين.",
        "is_visible": true
      },
      "contact": {
        "slug": "contact",
        "title_ar": "اتصل بنا والدعم",
        "subtitle_ar": "فريق الدعم الفني والمراجعة في خدمتك على مدار الساعة",
        "body_ar": "يمكنك التواصل معنا لمتابعة الطلبات أو الاستفسار عن وسائل الدفع وتوثيق الحساب عبر قنوات الدعم الرسمية أو إرسال تذكرة دعم مباشرة من هذه الصفحة.",
        "is_visible": true
      },
      "terms": {
        "slug": "terms",
        "title_ar": "الشروط والأحكام",
        "subtitle_ar": "الضوابط القانونية والتشغيلية وسياسة مكافحة غسل الأموال",
        "body_ar": "باستخدامك لمنصة تيتر ليبيا فإنك تقر بموافقتك الكاملة على ضوابط الامتثال ومكافحة غسل الأموال، وتتحمل المسؤولية القانونية الكاملة عن مصدر الأموال والغرض من استخدامها مع إخلاء مسؤولية المنصة التام عن أي تصرف غير مشروع، كما تخضع كافة التحويلات للرقابة والتدقيق.",
        "is_visible": true
      },
      "privacy": {
        "slug": "privacy",
        "title_ar": "سياسة الخصوصية",
        "subtitle_ar": "كيف نحمي بياناتك الشخصية ومستندات الهوية والإيصالات",
        "body_ar": "نلتزم بحماية خصوصية مستخدمينا وتشفير الجلسات وحفظ وثائق التحقق والإيصالات المصرفية في مخازن معزولة لا يصل إليها إلا فريق المراجعة المختص. لا نبيع أو نشارك بياناتك مع أي أطراف تسويقية، وتُستخدم البيانات حصراً للتحقق من الهوية والامتثال وتنفيذ الطلبات.",
        "is_visible": true
      },
      "risk-disclosure": {
        "slug": "risk-disclosure",
        "title_ar": "الإفصاحات والمخاطر",
        "subtitle_ar": "إرشادات السلامة المالية وتنبيهات الشبكة والامتثال",
        "body_ar": "التعامل في الأصول الرقمية يتطلب الحذر التام عند نسخ عناوين المحافظ واختيار الشبكة الصحيحة (TRON TRC20). التحويلات على البلوكشين غير قابلة للاسترجاع أو الإلغاء، والمنصة لا تقدم استشارات استثمارية بل توفر خدمة تنفيذ مباشر تخضع للمراجعة اليدوية.",
        "is_visible": true
      },
      "security": {
        "slug": "security",
        "title_ar": "الأمان والموثوقية",
        "subtitle_ar": "معايير الحماية والتدقيق الصارم في تيتر ليبيا",
        "body_ar": "نطبق تحققاً مزدوجاً لرقم الهاتف عبر رمز التحقق الهاتفي، وتوثيق الهوية بالوثائق الرسمية، ومنع تكرار أرقام الحوالات ومعرّفات البلوكشين (TX Hash)، مع سجل تدقيق غير قابل للتعديل ومراجعة بشرية مزدوجة قبل اعتماد أي تحويل صادر.",
        "is_visible": true
      },
      "rewards": {
        "slug": "rewards",
        "title_ar": "المكافآت والعروض",
        "subtitle_ar": "مزايا الحسابات الموثقة وبرامج الولاء",
        "body_ar": "يحصل العملاء ذوو الحسابات الموثقة والنشاط المنتظم على أولوية قصوى في سرعة المراجعة وهوامش سعرية تفضيلية وحدود تداول أعلى يتم الإعلان عنها عبر مركز الإشعارات الفورية.",
        "is_visible": true
      }
